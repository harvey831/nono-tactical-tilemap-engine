{"id": "110-2-B-079", "year": 110, "session": 2, "subject": "B", "number": 79, "stem": "NaI 偵檢器度量某核種發射之兩條加馬射線，其能量分別為 0.511 MeV 、 1.274 MeV 。此核種每秒發射出 0.511\nMeV 之加馬射線為 3000 個，而度量 20 分鐘後，偵檢器取得總計數值為 25000 counts ，則其偵測效率為何？", "options": {"A": "0.42", "B": "0.069", "C": "0.84", "D": "0.0069"}, "answer": "D", "answer_note": null, "answer_revised": false, "topics": [], "difficulty": null, "has_figure": false, "figures": [], "source": "sources/110_2/22_Q.pdf", "ingested_at": "2026-09-10T09:17:54+00:00", "needs_review": false}
