{"id": "110-2-B-065", "year": 110, "session": 2, "subject": "B", "number": 65, "stem": "直線能量轉移（ LET ）指每單位路徑長度下能量釋放的平均（ keV/µm ），下列射線依其 LET 由大到小依序排\n列，何者正確？ ①60Co 的 γ 射線 ② 250 kV X 射線 ③ 150 MeV 質子 ④ 2.5 MeV α 粒子", "options": {"A": "④③①②", "B": "④②③①", "C": "③④①②", "D": "④③②①"}, "answer": "B", "answer_note": null, "answer_revised": false, "topics": [], "difficulty": null, "has_figure": false, "figures": [], "source": "sources/110_2/22_Q.pdf", "ingested_at": "2026-09-10T09:17:54+00:00", "needs_review": false}
