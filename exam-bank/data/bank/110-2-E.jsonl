{"id": "110-2-E-002", "year": 110, "session": 2, "subject": "E", "number": 2, "stem": "關於表觀遺傳學（ epigenetics ）與 DNA 甲基化的敘述，下列何者正確？①一般指 DNA 序列沒有改變，但是基因\n的表現改變 ② DNA 甲基化通常發生在 CpG 二核苷酸胞嘧啶 5 碳的位置 ③部分動物實驗顯示表基因的改變可\n能是跨世代遺傳", "options": {"A": "①②③", "B": "僅①②", "C": "僅①③", "D": "僅②③"}, "answer": "A", "answer_note": null, "answer_revised": false, "topics": [], "difficulty": null, "has_figure": false, "figures": [], "source": "sources/110_2/55_Q.pdf", "ingested_at": "2026-09-10T09:17:54+00:00", "needs_review": false}
